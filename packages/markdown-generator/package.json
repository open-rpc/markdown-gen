{
  "name": "@open-rpc/markdown-generator",
  "module": "index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openrpc-md": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "private": false,
  "version": "0.1.0",
  "scripts": {
    "test": "bun test",
    "coverage": "bun test --coverage --coverage-reporter=lcov",
    "types": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev:watch": "bun build.ts --watch",
    "build": "bun build.ts && bun run types"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/node": "22.13.5",
    "typescript": "5.9",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4"
  },
  "dependencies": {
    "@open-rpc/schema-utils-js": "^2.1.2",
    "@types/mdast": "^4.0.4",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-frontmatter": "^2.0.1",
    "micromark-extension-gfm": "^3.0.0"
  }
}